+/* ========================================
+   INTERACTIVE ELEMENT STYLING
+   Makes clickable elements visually distinct
+   from non-clickable ones (UX clarity)
+   ======================================== */
+
+/* 1. All clickable elements get a pointer cursor */
+button,
+[role="button"],
+a,
+[role="slider"],
+[role="combobox"],
+[role="menuitem"],
+[role="option"],
+[role="tab"],
+[role="switch"],
+[role="checkbox"],
+[role="radio"],
+label:has(input),
+.cursor-pointer {
+  cursor: pointer;
+}
+
+/* 2. Disabled elements show not-allowed cursor + reduced opacity */
+button:disabled,
+[aria-disabled="true"],
+[data-disabled] {
+  cursor: not-allowed !important;
+  opacity: 0.5 !important;
+}
+
+/* 3. Primary buttons (solid) — bold hover with lift + shadow */
+button:not(:disabled):not([aria-disabled]):hover,
+[role="button"]:not(:disabled):hover,
+a:hover {
+  filter: brightness(1.05);
+}
+
+/* 4. Card-lift elements — shadow + lift on hover */
+.card-lift {
+  transition: transform 200ms ease, box-shadow 200ms ease, border-color 200ms ease;
+}
+.card-lift:hover {
+  transform: translateY(-3px);
+  box-shadow: 0 8px 25px -5px hsl(var(--primary) / 0.15), 0 4px 10px -3px hsl(var(--foreground) / 0.1);
+  border-color: hsl(var(--primary) / 0.3);
+}
+
+/* 5. Nav items — clear active + hover state */
+nav button {
+  transition: background-color 150ms ease, color 150ms ease, font-weight 150ms ease;
+}
+nav button[aria-current],
+nav button:hover {
+  font-weight: 600;
+}
+
+/* 6. Select triggers — focus ring + hover border */
+[data-slot="select-trigger"]:hover {
+  border-color: hsl(var(--primary) / 0.5) !important;
+}
+[data-slot="select-trigger"]:focus-visible {
+  border-color: hsl(var(--primary)) !important;
+  box-shadow: 0 0 0 3px hsl(var(--primary) / 0.15) !important;
+}
+
+/* 7. Copy-link buttons — always visible (not hidden until hover) */
+button[aria-label*="Copy link"] {
+  opacity: 0.5;
+  transition: opacity 150ms ease, color 150ms ease, background-color 150ms ease;
+}
+button[aria-label*="Copy link"]:hover,
+button[aria-label*="Copy link"]:focus-visible {
+  opacity: 1;
+  color: hsl(var(--primary));
+  background-color: hsl(var(--primary) / 0.1);
+}
+
+/* 8. Preset scenario cards — bold active state + hover */
+button[aria-label*="Start guided tour"],
+button:has(> .text-primary):hover {
+  transform: translateY(-1px);
+}
+
+/* 9. Chart interaction — crosshair cursor on hover */
+.recharts-wrapper,
+.recharts-surface {
+  cursor: crosshair;
+}
+.recharts-tooltip-wrapper {
+  cursor: default;
+}
+
+/* 10. Links in content — underline on hover */
+a:not([href^="#"]):not([href^="http"]):hover,
+main a[href^="#"]:hover {
+  text-decoration: underline;
+  text-underline-offset: 3px;
+}
+
+/* 11. Badge/chip hover (filter pills, glossary filters) */
+button.rounded-full:hover {
+  transform: scale(1.03);
+}
+
+/* 12. Table rows — hover highlight (interactive feel) */
+.data-table tbody tr {
+  cursor: default;
+}
+
+/* 13. Tooltip trigger elements — help cursor */
+[title],
+.cursor-help {
+  cursor: help;
+}
+
+/* 14. Heatmap cells — pointer + scale on hover */
+[title*="↔"],
+[title*="Predicted"] {
+  cursor: pointer;
+  transition: transform 150ms ease, outline 150ms ease;
+}
+[title*="↔"]:hover,
+[title*="Predicted"]:hover {
+  transform: scale(1.15);
+  z-index: 10;
+  outline: 2px solid hsl(var(--primary));
+  outline-offset: 1px;
+}
+
 /* Animated gradient orb (hero) */
 @keyframes orb-drift {
   0%, 100% { transform: translate(0, 0) scale(1); }
