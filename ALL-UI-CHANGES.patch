+  border: 1px solid rgba(255, 255, 255, 0.08);
+}
+
+/* Glow effect for primary buttons */
+.glow-btn {
+  position: relative;
+  overflow: hidden;
+  transition: transform 200ms ease, box-shadow 200ms ease;
+}
+.glow-btn::after {
+  content: "";
+  position: absolute;
+  inset: 0;
+  background: radial-gradient(circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(255,255,255,0.3), transparent 50%);
+  opacity: 0;
+  transition: opacity 200ms ease;
+  pointer-events: none;
+}
+.glow-btn:hover::after {
+  opacity: 1;
+}
+.glow-btn:hover {
+  transform: translateY(-2px) scale(1.02);
+  box-shadow: 0 10px 30px -5px var(--glow), 0 0 0 1px var(--primary);
+}
+.glow-btn:active {
+  transform: translateY(0) scale(0.98);
+}
+
 /* Subtle dot grid background (hero) */
 .dot-grid {
   background-image: radial-gradient(hsl(var(--foreground) / 0.06) 1px, transparent 1px);
